# Google OAuth (console.cloud.google.com > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
# generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Set to true if you want approved changes to email invitees. Off by default so demos never ping real people.
SEND_INVITES=false
